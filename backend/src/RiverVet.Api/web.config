<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración para IIS e IIS Express.
     Al publicar, el SDK reemplaza LAUNCHER_PATH y LAUNCHER_ARGS por la ruta
     real de la aplicación. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" hostingModel="inprocess" stdoutLogEnabled="false" />
      <!-- No anunciar la tecnología del servidor: información que solo le sirve a un atacante. -->
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
    </system.webServer>
  </location>
</configuration>
