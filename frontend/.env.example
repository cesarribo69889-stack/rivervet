# ═══════════════════════════════════════════════════════════════════════
#  RiverVet frontend — variables de entorno
#  Copia este archivo como .env.local si necesitas cambiar algo.
#
#  ⚠ TODO lo que empiece con VITE_ se INCRUSTA en el JavaScript que descarga
#  el navegador: cualquiera lo puede ver con F12. Aquí NUNCA van secretos,
#  claves de API ni contraseñas.
# ═══════════════════════════════════════════════════════════════════════

# Ruta base de la API. Déjala en /api: en desarrollo la atiende el proxy de
# Vite y en producción el rewrite de vercel.json (mismo origen = cookies y
# CSRF funcionan sin CORS).
VITE_API_URL=/api

# Minutos sin actividad antes de cerrar la sesión automáticamente.
VITE_INACTIVIDAD_MINUTOS=30

# Solo para el servidor de desarrollo (NO llega al navegador porque no
# empieza con VITE_): a dónde reenvía el proxy las peticiones a /api.
API_PROXY_DESTINO=http://localhost:3000
